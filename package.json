{
  "name": "descriptor",
  "version": "0.1.0",
  "description": "Local-first transcript-led video editor for Arabic and Arabic-English creators.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alhasanpro/descriptor.git"
  },
  "bugs": {
    "url": "https://github.com/Alhasanpro/descriptor/issues"
  },
  "homepage": "https://github.com/Alhasanpro/descriptor#readme",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.6.2",
  "keywords": [
    "arabic",
    "captions",
    "electron",
    "local-ai",
    "ollama",
    "transcription",
    "video-editor",
    "whisper-cpp"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop:prepare": "npm run build && node desktop/prepare-server.mjs",
    "desktop:package": "npm run desktop:prepare && node desktop/package.mjs dir",
    "desktop:dist": "npm run desktop:prepare && node desktop/package.mjs dmg",
    "lint": "eslint .",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.10",
    "typescript": "npm:@typescript/typescript6@^6.0.0"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
