# Local speech and language runtimes. No cloud credential is used.
# Both Whisper paths must be absolute. See docs/GETTING_STARTED.md.
WHISPER_CPP_BINARY=/absolute/path/to/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL=/absolute/path/to/ggml-large-v3.bin
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TRANSLATION_MODEL=qwen3:8b-q4_K_M
MAX_UPLOAD_BYTES=21474836480

# Optional macOS package output. Leave unset to use ./dist.
# DESCRIPTOR_DESKTOP_OUTPUT=/absolute/path/to/dist
